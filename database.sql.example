-- ==============================================================================
-- BUNANUR CARE - DATABASE SCHEMA & INITIAL SEED TEMPLATE (database.sql.example)
-- Framework: CodeIgniter 4 | Database Engine: MySQL / MariaDB (InnoDB, utf8mb4)
-- ==============================================================================

CREATE DATABASE IF NOT EXISTS `klinik_db` CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
USE `klinik_db`;

SET FOREIGN_KEY_CHECKS = 0;

-- ------------------------------------------------------------------------------
-- Table structure for `bidan`
-- ------------------------------------------------------------------------------
DROP TABLE IF EXISTS `bidan`;
CREATE TABLE `bidan` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `nama` varchar(100) DEFAULT NULL,
  `username` varchar(50) NOT NULL,
  `password` varchar(255) NOT NULL,
  `foto` varchar(100) DEFAULT 'default.png',
  `hero_foto` varchar(100) DEFAULT NULL,
  `logo_hero` varchar(100) DEFAULT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `last_seen` datetime DEFAULT NULL,
  `email` varchar(100) DEFAULT NULL,
  `whatsapp` varchar(20) DEFAULT NULL,
  `alamat` text DEFAULT NULL,
  `spesialis` varchar(100) DEFAULT NULL,
  `instagram` varchar(100) DEFAULT NULL,
  `facebook` varchar(100) DEFAULT NULL,
  `tiktok` varchar(100) DEFAULT NULL,
  `tentang` text DEFAULT NULL,
  `hero_judul` varchar(150) DEFAULT NULL,
  `hero_subjudul` varchar(150) DEFAULT NULL,
  `deskripsi_beranda` text DEFAULT NULL,
  `foto_tentang` varchar(100) DEFAULT NULL,
  `biografi` text DEFAULT NULL,
  `visi_misi` text DEFAULT NULL,
  `status` enum('online','offline') DEFAULT 'offline',
  PRIMARY KEY (`id`),
  UNIQUE KEY `username` (`username`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- ------------------------------------------------------------------------------
-- Table structure for `pasien`
-- ------------------------------------------------------------------------------
DROP TABLE IF EXISTS `pasien`;
CREATE TABLE `pasien` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `nama` varchar(100) NOT NULL,
  `foto_profil` varchar(255) DEFAULT NULL,
  `username` varchar(100) NOT NULL,
  `email` varchar(100) NOT NULL,
  `no_hp` varchar(20) NOT NULL,
  `alamat` text NOT NULL,
  `password` varchar(255) NOT NULL,
  `foto` varchar(100) DEFAULT 'default.png',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `last_seen` datetime DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `username` (`username`),
  UNIQUE KEY `email` (`email`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- ------------------------------------------------------------------------------
-- Table structure for `layanan`
-- ------------------------------------------------------------------------------
DROP TABLE IF EXISTS `layanan`;
CREATE TABLE `layanan` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `nama_layanan` varchar(100) DEFAULT NULL,
  `harga` int(11) DEFAULT NULL,
  `durasi` varchar(50) DEFAULT NULL,
  `deskripsi` text DEFAULT NULL,
  `foto` varchar(255) DEFAULT NULL,
  `kategori` varchar(50) DEFAULT NULL,
  `gambar` varchar(255) DEFAULT NULL,
  `status` enum('aktif','nonaktif') DEFAULT 'aktif',
  `kuota` int(11) DEFAULT 0,
  `icon` varchar(50) DEFAULT 'bx-plus-medical',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  `bidan_id` int(11) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- ------------------------------------------------------------------------------
-- Table structure for `kunjungan`
-- ------------------------------------------------------------------------------
DROP TABLE IF EXISTS `kunjungan`;
CREATE TABLE `kunjungan` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `pasien_id` int(11) DEFAULT NULL,
  `layanan` int(11) DEFAULT NULL,
  `tanggal` date DEFAULT NULL,
  `jam` time DEFAULT NULL,
  `status` enum('menunggu','disetujui','selesai','Menunggu','Gagal') DEFAULT 'menunggu',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `nama_pasien` varchar(100) DEFAULT NULL,
  `usia` int(11) DEFAULT NULL,
  `nama_ortu` varchar(100) DEFAULT NULL,
  `kategori_pendamping` enum('Suami','Ibu','Ayah','Wali') DEFAULT 'Suami',
  `alamat` text DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `pasien_id` (`pasien_id`),
  KEY `layanan_id` (`layanan`),
  CONSTRAINT `kunjungan_ibfk_1` FOREIGN KEY (`pasien_id`) REFERENCES `pasien` (`id`) ON DELETE CASCADE,
  CONSTRAINT `kunjungan_ibfk_2` FOREIGN KEY (`layanan`) REFERENCES `layanan` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- ------------------------------------------------------------------------------
-- Table structure for `testimoni`
-- ------------------------------------------------------------------------------
DROP TABLE IF EXISTS `testimoni`;
CREATE TABLE `testimoni` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `kunjungan_id` int(11) NOT NULL,
  `rating` int(11) DEFAULT NULL,
  `approve` enum('Menunggu','Selesai') NOT NULL DEFAULT 'Menunggu',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `pasien_id` int(11) NOT NULL,
  `pesan` text DEFAULT NULL,
  `ulasan` text NOT NULL,
  `foto` varchar(255) DEFAULT NULL,
  `nama_layanan` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `fk_testimoni_kunjungan_final` (`kunjungan_id`),
  KEY `fk_testimoni_pasien_final` (`pasien_id`),
  CONSTRAINT `fk_testimoni_kunjungan_final` FOREIGN KEY (`kunjungan_id`) REFERENCES `kunjungan` (`id`) ON DELETE CASCADE ON UPDATE CASCADE,
  CONSTRAINT `fk_testimoni_pasien_final` FOREIGN KEY (`pasien_id`) REFERENCES `pasien` (`id`) ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- ------------------------------------------------------------------------------
-- Table structure for `chat`
-- ------------------------------------------------------------------------------
DROP TABLE IF EXISTS `chat`;
CREATE TABLE `chat` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `pasien_id` int(11) DEFAULT NULL,
  `bidan_id` int(11) DEFAULT NULL,
  `pesan` text DEFAULT NULL,
  `pengirim` enum('user','bidan') DEFAULT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `status` enum('terkirim','dibalas') DEFAULT 'terkirim',
  `id_pasien` int(11) NOT NULL,
  `status_baca` enum('terkirim','dibaca') DEFAULT 'terkirim',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- ------------------------------------------------------------------------------
-- Table structure for `profil`
-- ------------------------------------------------------------------------------
DROP TABLE IF EXISTS `profil`;
CREATE TABLE `profil` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `hero_title` varchar(255) DEFAULT NULL,
  `hero_subtitle` varchar(255) DEFAULT NULL,
  `visi_misi` text DEFAULT NULL,
  `hero_foto` varchar(255) DEFAULT 'Logo.png',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- ------------------------------------------------------------------------------
-- Table structure for `galeri_beranda`
-- ------------------------------------------------------------------------------
DROP TABLE IF EXISTS `galeri_beranda`;
CREATE TABLE `galeri_beranda` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `tipe` enum('foto','video') DEFAULT 'foto',
  `file_name` varchar(255) NOT NULL,
  `judul` varchar(255) DEFAULT '',
  `urutan` int(11) DEFAULT 0,
  `waktu_unggah` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- ------------------------------------------------------------------------------
-- Table structure for `tentang_slider`
-- ------------------------------------------------------------------------------
DROP TABLE IF EXISTS `tentang_slider`;
CREATE TABLE `tentang_slider` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `foto` varchar(255) DEFAULT NULL,
  `judul` varchar(255) DEFAULT NULL,
  `status` enum('aktif','nonaktif') DEFAULT 'aktif',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

