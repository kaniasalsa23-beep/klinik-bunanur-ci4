# ==============================================================================
# BUNANUR CARE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instruksi: Salin file ini menjadi .env kemudian sesuaikan nilai konfigurasi
# dengan environment lokal / server Anda.
# JANGAN PERNAH menyimpan credential produksi asli atau melakukan commit file .env ke Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# ENVIRONMENT (development / testing / production)
# ------------------------------------------------------------------------------
CI_ENVIRONMENT = development

# ------------------------------------------------------------------------------
# APP CONFIGURATION
# ------------------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'ci_session'
app.sessionExpiration = 7200
app.sessionSavePath = null
app.sessionMatchIP = false
app.sessionTimeToUpdate = 300
app.sessionRegenerateDestroy = false

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (MySQL / MariaDB)
# ------------------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = klinik_db
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# ------------------------------------------------------------------------------
# SECURITY & CRYPTOGRAPHY KEYS
# ------------------------------------------------------------------------------
# Generate encryption key via: php spark key:generate --show
encryption.key = hex2bin:your_32_byte_hex_encoded_encryption_key_here

# Stateless JWT Authentication Secret Key (HMAC-SHA256)
JWT_SECRET = your_super_secret_cryptographic_jwt_key_min_32_characters_here

# ------------------------------------------------------------------------------
# LOGGING & DEBUGGING
# ------------------------------------------------------------------------------
# 0 = Off, 1 = Error, 2 = Critical, 3 = Alert, 4 = Info, 9 = All
logger.threshold = 4

# ------------------------------------------------------------------------------
# WHATSAPP OTP GATEWAY CONFIGURATION (FONNTE)
# ------------------------------------------------------------------------------
WHATSAPP_GATEWAY_URL = "https://api.fonnte.com/send"
FONNTE_TOKEN = "your_fonnte_api_token_here"
WHATSAPP_GATEWAY_TOKEN = "your_fonnte_api_token_here"
WHATSAPP_API_TOKEN = "your_fonnte_api_token_here"
BIDAN_OFFICIAL_WHATSAPP = "6281224841377"

