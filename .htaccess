# ======================================================================
# Klinik Bunanur CI4 - Root .htaccess (cPanel public_html)
# DEPLOYMENT: Seluruh proyek CI4 di dalam public_html/
# Web root cPanel menunjuk ke:  public_html/public/
# ======================================================================

# Disable directory browsing
Options -Indexes

<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On

    # ============================================================
    # FORCE HTTPS — proxy-aware, anti-redirect-loop
    # CPanel SSL terminates di load balancer; header X-Forwarded-Proto
    # harus diperiksa agar tidak terjadi loop redirect tanpa akhir.
    # ============================================================
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ============================================================
    # Block direct access to sensitive project files & folders
    # (app/, system/, writable/, .env, vendor/, dll.)
    # ============================================================
    RewriteRule ^(\.env|\.git|app|system|writable|tests|vendor|composer\.(json|lock)|phpunit\.xml|spark|builds|preload\.php)(/|$) - [F,L,NC]

    # ============================================================
    # KRITIS: Izinkan file & folder yang SUDAH ADA secara fisik
    # di dalam public_html/ agar tidak di-rewrite ke public/$1.
    # Ini mencegah CSS/JS/gambar yang ada di public/assets/
    # dilewatkan dua kali dan menyebabkan URL ganda /public/assets/.
    # ============================================================
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ============================================================
    # Teruskan semua request lain ke public/ (front controller CI4)
    # ============================================================
    RewriteRule ^(.*)$ public/$1 [L,QSA]

</IfModule>

# Fallback jika mod_rewrite tidak aktif
<IfModule !mod_rewrite.c>
    ErrorDocument 404 public/index.php
</IfModule>

# ==================================================================
# PERFORMANCE: Browser Caching untuk aset statis
# ==================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg      "access plus 1 month"
    ExpiresByType image/png       "access plus 1 month"
    ExpiresByType image/webp      "access plus 1 month"
    ExpiresByType image/gif       "access plus 1 month"
    ExpiresByType image/svg+xml   "access plus 1 month"
    ExpiresByType image/x-icon    "access plus 1 year"
    ExpiresByType text/css        "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2      "access plus 1 year"
    ExpiresByType font/woff       "access plus 1 year"
    ExpiresByType video/mp4       "access plus 1 month"
</IfModule>

# Security: Hide server info
ServerSignature Off
<IfModule mod_headers.c>
    Header unset X-Powered-By
</IfModule>
